# ─────────────────────────────────────────────
# Environment variables for Job Search Agent
# Copy this file to .env — NEVER commit .env to git.
# ─────────────────────────────────────────────

# Gmail SMTP credentials
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here   # 16-char App Password, not your account password
EMAIL_RECIPIENT=gspr4033@gmail.com

# Optional SMTP overrides
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
